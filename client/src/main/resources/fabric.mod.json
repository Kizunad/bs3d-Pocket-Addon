{
  "schemaVersion": 1,
  "id": "bs3d_pocket",
  "version": "${version}",
  "name": "BS3D Pocket Addon",
  "contact": {
    "homepage": "https://github.com/Kizunad/bs3d-Pocket-Addon",
    "sources": "https://github.com/Kizunad/bs3d-Pocket-Addon",
    "issues": "https://github.com/Kizunad/bs3d-Pocket-Addon/issues"
  },
  "icon": "assets/bs3d_pocket/icon.png",
  "description": "Limits the main inventory to one row of pockets alongside the hotbar.\n原版主物品栏保留一排口袋，快捷栏仍可照常使用。",
  "environment": "client",
  "authors": [
    "Kizunad"
  ],
  "license": "MIT",
  "entrypoints": {
    "main": [
      "dev.kizuna.bs3d.pocket.server.PocketServer"
    ],
    "client": [
      "dev.kizuna.bs3d.pocket.client.PocketClient"
    ]
  },
  "depends": {
    "java": ">=25",
    "minecraft": "26.2",
    "fabricloader": ">=0.20.1",
    "fabric-api": ">=0.161.0+26.2",
    "backpack_storage_3d": "0.1.0",
    "bs3d_vanilla_addon": "0.1.0"
  },
  "mixins": [
    "bs3d.pocket.mixins.json",
    "bs3d.pocket.client.mixins.json"
  ]
}
